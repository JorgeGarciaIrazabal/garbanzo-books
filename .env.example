# Garbanzo Books — copy to .env (git-ignored) and fill in.

# --- Image generation: Google "Nano Banana" (default provider) ---
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # original Nano Banana (default)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image       # "Nano Banana Pro" (higher quality)
# IMAGE_PROVIDER=nano-banana                  # nano-banana | openai | placeholder

# --- Alternative image provider (optional) ---
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Dynamic UI chat console (ui/) ---
# The studio chat uses OpenCode + a LOCAL Ollama model — NO API KEY NEEDED.
# Prereqs: `ollama` running, the model pulled (`ollama pull minimax-m3:cloud`), and `opencode`
# installed (https://opencode.ai). Optional overrides:
# OPENCODE_MODEL=ollama/minimax-m3:cloud   # provider/model OpenCode should use
# PORT=4317                                 # UI port
