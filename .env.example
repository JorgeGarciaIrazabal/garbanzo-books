# Garbanzo Books — copy to .env (git-ignored) and fill in.

# --- Image generation ---
# The DEFAULT provider is "codex" — the Codex CLI (codex exec) and its built-in image
# generation tool, running on your ChatGPT session. No API key needed. Install codex and
# `codex login`. Fallbacks: agy (Google OAuth), nano-banana (GEMINI_API_KEY), or the
# fully-local Qwen-Image path below.
# IMAGE_PROVIDER=codex                       # codex | antigravity | local(=Qwen) | flux2 | nano-banana | openai | placeholder
# CODEX_MODEL=gpt-5.6-luna                     # codex exec model override
# CODEX_IMAGE_AGENT=codex                     # codex | agy — which CLI renders first
# --- Fully-local provider (iGPU, no network) ---
# Start the server with the Strix-Halo toolbox:
#   experiments/qwen-image-edit/docker_comfyui.sh   (publishes ComfyUI on :8188)
# COMFYUI_HOST=127.0.0.1:8188                 # where the ComfyUI server listens
# COMFYUI_TIMEOUT=900                          # max seconds per render (FLUX.2 is slow)
# Optional model-file overrides (must exist in the ComfyUI server's models dir):
# COMFYUI_QWEN_UNET=qwen-image-2512-Q4_K_M.gguf
# COMFYUI_FLUX2_UNET=flux2-dev-Q4_K_M.gguf
# COMFYUI_QWEN_EDIT_UNET=qwen-image-edit-2511-Q4_K_M.gguf
#
# Visual QC + auto-edit: a vision model scores each render; if it flags a character/scene
# inconsistency, ONE Qwen-Image-Edit pass repairs it. Default reviewer is MiniMax-M3.
# VISION_QC_MODEL=glm-5.3-flash:cloud          # any vision model your Ollama can serve
#
# Cloud fallbacks (optional). Google "Nano Banana": free key https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTIGRAVITY_MODEL=gemini-3-pro-image            # antigravity (local agy CLI via Google OAuth)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image           # nano-banana model override ("Nano Banana Pro";
#                                                 # gemini-3.1-flash-image = fast tier)
# GEMINI_IMAGE_SIZE=1K                            # 1K (default) | 2K | 4K on Nano Banana Pro

# --- Alternative image provider (optional) ---
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# --- Dynamic UI chat console (ui/) ---
# The studio chat uses OpenCode + a LOCAL Ollama model — NO API KEY NEEDED.
# Prereqs: `ollama` running, the model pulled (`ollama pull glm-5.3-flash:cloud`), and `opencode`
# installed (https://opencode.ai). Optional overrides:
# OPENCODE_MODEL=ollama/glm-5.3-flash:cloud# provider/model OpenCode should use
# PORT=4317                                 # UI port
